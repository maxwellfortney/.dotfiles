# Logs directory (generated by sync-state.sh)
logs/*.log

# Keep the logs directory but ignore log files
!logs/.gitkeep

# Docker
.dockerignore

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor files
*.swp
*.swo
*~
.vscode/
.idea/

# Temporary files
*.tmp
*.bak

# Installed by tools into the stowed ~/.local/bin, not dotfiles
bin/.local/bin/belt
bin/.local/bin/codex
bin/.local/bin/firecrawl
bin/.local/bin/inferencesh
bin/.local/bin/infsh

# Empty file apps create in the stowed ~/.local/share/applications
desktop-entries/.local/share/applications/mimeapps.list
