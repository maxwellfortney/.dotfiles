{
    "apps": [
        {
            "name": "Desktop"
        },
        {
            "auto-detach": true,
            "exit-timeout": 5,
            "name": "Headless",
            "prep-cmd": [
                {
                    "do": "sh -c \"hyprctl eval \\\"hl.monitor({ output = 'HEADLESS-2', mode = '${SUNSHINE_CLIENT_WIDTH}x${SUNSHINE_CLIENT_HEIGHT}@${SUNSHINE_CLIENT_FPS}', position = 'auto', scale = 1 })\\\"\"",
                    "undo": "hyprctl eval \"hl.monitor({ output = 'HEADLESS-2', disabled = true })\""
                },
                {
                    "do": "hyprctl eval \"hl.monitor({ output = 'HDMI-A-2', disabled = true })\"",
                    "undo": "hyprctl reload"
                }
            ],
            "wait-all": true
        }
    ],
    "env": {
        "PATH": "$(PATH):$(HOME)/.local/bin"
    }
}
