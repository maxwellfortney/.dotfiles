#!/bin/bash
# Toggle between HDMI-A-2 (3840x2160@240) and DP-1 (3440x1440@100).
# Run locally under Hyprland; uses hyprctl to switch the active display.
# Hyprland 0.57+ configures in Lua, so monitors change through `hyprctl eval`
# (the old `hyprctl keyword monitor` is gone).

set -e

readonly HDMI='HDMI-A-2'
readonly HDMI_MONITOR='{ output = "HDMI-A-2", mode = "3840x2160@240", position = "0x0", scale = 1.0666667 }'
readonly DP='DP-1'
readonly DP_MONITOR='{ output = "DP-1", mode = "3440x1440@100", position = "0x0", scale = 1 }'

monitors_output=$(hyprctl monitors 2>/dev/null) || true
if [[ -z "$monitors_output" ]]; then
  echo "toggle-monitor: hyprctl monitors produced no output (Hyprland not running?)" >&2
  exit 1
fi

if [[ "$monitors_output" == *"$HDMI"* ]]; then
  # HDMI-A-2 is active -> switch to DP-1
  hyprctl eval "hl.monitor({ output = \"$HDMI\", disabled = true })"
  hyprctl eval "hl.monitor($DP_MONITOR)"
  echo "Switched to $DP"
else
  # DP-1 is active (or neither) -> switch to HDMI-A-2
  hyprctl eval "hl.monitor({ output = \"$DP\", disabled = true })"
  hyprctl eval "hl.monitor($HDMI_MONITOR)"
  echo "Switched to $HDMI"
fi
